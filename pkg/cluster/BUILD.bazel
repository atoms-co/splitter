load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cluster",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.atoms.co/splitter/pkg/cluster",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/core",
        "//pkg/model",
        "//pkg/service/leader",
        "//proto/atoms/splitter/private:private_go_proto",
        "@co_atoms_go_iox//:iox",
        "@co_atoms_go_lib//chanx",
        "@co_atoms_go_lib//log",
        "@co_atoms_go_lib//metrics",
        "@co_atoms_go_lib//net/grpcx",
        "@co_atoms_go_lib//randx",
        "@co_atoms_go_lib//syncx",
        "@com_github_hashicorp_raft//:raft",
        "@com_github_hashicorp_raft_boltdb_v2//:raft-boltdb",
    ],
)

go_test(
    name = "cluster_test",
    srcs = ["cluster_test.go"],
    embed = [":cluster"],
    deps = [
        "//pkg/service/leader",
        "//pkg/storage/raft",
        "@co_atoms_go_lib//testing/assertx",
        "@com_github_hashicorp_raft//:raft",
        "@com_github_stretchr_testify//require",
    ],
)
